# Streamlit Cloud Secrets Configuration
# Copy this to .streamlit/secrets.toml and fill in your values
# DO NOT commit secrets.toml to git!

[smart]
SMART_FHIR_BASE_URL = "https://thas.mohw.gov.tw/v/r4/sim/YOUR_ISS_URL/fhir"
SMART_CLIENT_ID = "your_client_id_from_sandbox"
SMART_REDIRECT_URI = "https://your-app.streamlit.app/callback"
