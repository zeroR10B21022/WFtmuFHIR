# SMART on FHIR Configuration
# Copy this file to .env and update the values

# For testing with public SMART Health IT sandbox
SMART_FHIR_BASE_URL=https://r4.smarthealthit.org
SMART_CLIENT_ID=my_web_app
SMART_REDIRECT_URI=http://localhost:8501/callback

# For Taiwan MOHW Sandbox (after registration)
# SMART_FHIR_BASE_URL=https://hapi.fhir.tw/fhir
# SMART_CLIENT_ID=your-client-id-here
# SMART_REDIRECT_URI=http://localhost:8501/callback
